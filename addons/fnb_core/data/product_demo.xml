        <field name="fnb_storage_condition">ambient</field>
        <field name="fnb_shelf_life_days">365</field>
        <field name="fnb_requires_traceability">False</field>
    </record>

    <record id="product_template_fnb_demo_bottled_tea" model="product.template">
        <field name="name">F&amp;B Demo Bottled Tea</field>
        <field name="default_code">FG-TEA-001</field>
