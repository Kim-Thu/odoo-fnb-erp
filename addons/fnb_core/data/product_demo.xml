<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_template_fnb_demo_milk" model="product.template">
        <field name="name">F&amp;B Demo Fresh Milk</field>
        <field name="default_code">RM-MILK-001</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="purchase_ok">True</field>
        <field name="sale_ok">False</field>
        <field name="fnb_internal_sku">FNB-RM-MILK-001</field>
        <field name="fnb_ingredient_classification">raw</field>
        <field name="fnb_storage_condition">chilled</field>
        <field name="fnb_shelf_life_days">7</field>
        <field name="fnb_requires_traceability">True</field>
        <field name="tracking">lot</field>
        <field name="use_expiration_date">True</field>
    </record>

