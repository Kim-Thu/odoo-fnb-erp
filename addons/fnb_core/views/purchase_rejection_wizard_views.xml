<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fnb_purchase_rejection_wizard_form" model="ir.ui.view">
        <field name="name">fnb.purchase.rejection.wizard.form</field>
        <field name="model">fnb.purchase.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <group>
                    <field name="purchase_order_id"/>
                    <field name="reason" placeholder="Explain why this purchase order is rejected..."/>
                </group>
                <footer>
                    <button
                        name="action_confirm_rejection"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
