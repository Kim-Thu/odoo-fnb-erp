<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_fnb_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.fnb.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_approve_fnb"
                    type="object"
                    string="Approve F&amp;B"
                    class="btn-primary"
                    groups="fnb_core.group_fnb_purchase_approver"
                    invisible="not approval_required or approval_state == 'approved' or state not in ('draft', 'sent')"
                />
                <button
                    name="action_open_rejection_wizard"
                    type="object"
                    string="Reject F&amp;B"
                    groups="fnb_core.group_fnb_purchase_approver"
                    invisible="not approval_required or state not in ('draft', 'sent')"
                />
            </xpath>

            <xpath expr="//sheet/notebook" position="before">
                <group string="F&amp;B Approval" invisible="not approval_required">
                    <field name="approval_required" invisible="1"/>
                    <field name="approval_state" widget="badge"/>
                    <field name="approved_by_id"/>
                    <field name="approved_at"/>
                    <field name="rejection_reason" invisible="not rejection_reason"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_fnb_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fnb.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="F&amp;B ERP" name="fnb_erp">
                    <block title="Purchase Approval">
                        <setting
                            string="Approval threshold"
                            help="Purchase orders at or above this amount require approval before confirmation."
                        >
                            <field name="fnb_purchase_approval_limit"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
