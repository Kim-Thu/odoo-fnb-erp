# Copy to .env and replace every placeholder before starting.
ODOO_IMAGE=odoo:18.0
POSTGRES_IMAGE=postgres:16-alpine
ODOO_PORT=8069
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-a-long-random-password
ODOO_ADMIN_PASSWD=replace-with-a-long-random-master-password
TZ=Asia/Ho_Chi_Minh
